# Offline local demo. Uvicorn: --env-file .env; Compose reads this itself.
APP_ENV=development
DATABASE_URL=sqlite+pysqlite:///./dynamic_leverage.db
AUTO_CREATE_SCHEMA=true
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:5173
SHIOAJI_MODE=disabled
INITIAL_STRATEGY_NAV=500000
PRODUCTION_ORDER_SUBMISSION_ENABLED=false
TWSE_MARKET_VALUATION_URL=https://www.twse.com.tw/zh/trading/statistics/index04.html
MOPS_MARKET_EPS_URL=https://openapi.twse.com.tw/v1/opendata/t187ap14_L

# Compose-only empty mount. Do not mount personal credentials for a demo.
DVL_SECRET_FILE=./config/empty-secrets.env

# Optional: uncomment only after configuring external read-only credentials.
# SHIOAJI_SECRET_FILE=/path/to/external/runtime.env
# SHIOAJI_ACCOUNT_ID=example-binding
# TELEGRAM_SECRET_FILE=/path/to/external/runtime.env
# FINMIND_TOKEN_FILE=/path/to/external/token.txt
